# Copiar a .env y ajustar. Lo leen tanto docker-compose.dev.yml como la app.

# --- Servidor ---
SERVER_PORT=8000
# Puerto publicado en el host por docker-compose.dev.yml.
BACKEND_PORT=8000

# --- Base de datos ---
DB_NAME=xeye
DB_USERNAME=xeye
DB_PASSWORD=xeye
DB_ROOT_PASSWORD=rootpassword
# Puerto publicado en el host (3307 para no chocar con la MariaDB legacy del 3306).
DB_PORT=3307
# Datasource de la app (solo hace falta al ejecutarla en el host, no en compose).
DB_URL=jdbc:mysql://localhost:3307/xeye?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# --- JWT ---
# Mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- Training ---
# Providers: mock (simula en proceso, por defecto en dev) | docker (un contenedor local por
# training) | lambda (AWS Lambda asíncrona) | runpod (endpoint Serverless de RunPod).
TRAINING_PROVIDER=mock
# Secreto de la cabecera X-Webhook-Token del callback del worker.
TRAINING_WEBHOOK_SECRET=
# URL base pública a la que el worker llama de vuelta (…/webhooks/training-update);
# desde otro contenedor no es localhost (p. ej. http://xeye-java-backend:8000).
BACKEND_URL=http://localhost:8000
# Modelos ofrecidos al lanzar (el primero = por defecto); worker y search-service deben poder cargarlos.
TRAINING_EMBEDDING_MODELS=paraphrase-multilingual-MiniLM-L12-v2,paraphrase-multilingual-mpnet-base-v2
# Retardo de la finalización simulada del provider mock (ms).
TRAINING_MOCK_DELAY_MS=500
# Minutos sin webhook tras los que un training lanzado se marca fallido; 0 desactiva el barrido.
TRAINING_STALLED_AFTER_MINUTES=30

# --- Training: provider docker ---
TRAINING_DOCKER_IMAGE=xeye-training-service:latest
# Dónde escribe este proceso el JSON del job, y ese mismo directorio tal como lo ve el
# daemon de docker (difieren cuando el backend corre en contenedor).
TRAINING_INPUT_DIR=/tmp/xeye-training
TRAINING_HOST_INPUT_DIR=/tmp/xeye-training
TRAINING_DOCKER_NETWORK=xeye-network
# Variables KEY=VALUE extra para el worker, p. ej. ENRICHER=groq,GROQ_API_KEY=...
TRAINING_DOCKER_ENV=
# Valor de `docker run --gpus` ("all", "device=0", …); si no hay GPU se reintenta en CPU. Vacío fuerza CPU.
TRAINING_DOCKER_GPUS=all
TRAINING_DOCKER_BINARY=docker

# --- Training: provider lambda ---
TRAINING_LAMBDA_FUNCTION=
AWS_REGION=

# --- Training: provider runpod ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TIMEOUT_SECONDS=30

# --- Search ---
# Providers: log (solo loguea, por defecto en dev) | http (POST al microservicio de búsqueda).
SEARCH_PROVIDER=log
SEARCH_SERVICE_URL=http://localhost:8002
# Secreto compartido backend<->search (pushes, notificaciones y /internal/search/*).
SEARCH_INTERNAL_TOKEN=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
