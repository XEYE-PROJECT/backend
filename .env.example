# Copiar a .env y ajustar. Lo leen tanto docker-compose.dev.yml como la app.
# Perfil: dev (mvn spring-boot:run y docker-compose.dev.yml lo activan) o prod (la imagen lo
# fija). En prod TODO lo marcado "obligatorio" debe existir y ser fuerte: si no, no arranca.

# --- Servidor ---
SERVER_PORT=8000
# Puerto publicado en el host por docker-compose.dev.yml.
BACKEND_PORT=8000

# --- Base de datos ---
DB_NAME=xeye
DB_USERNAME=xeye
DB_PASSWORD=xeye
DB_ROOT_PASSWORD=rootpassword
# Puerto publicado en el host (3307 para no chocar con la MariaDB legacy del 3306).
DB_PORT=3307
# Datasource de la app (solo hace falta al ejecutarla en el host, no en compose).
DB_URL=jdbc:mysql://localhost:3307/xeye?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC

# --- JWT ---
# Obligatorio en prod. Mínimo 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- Training ---
# Providers: mock (simula en proceso, por defecto en dev) | docker (un contenedor local por
# training) | runpod (endpoint Serverless de RunPod).
TRAINING_PROVIDER=mock
# Secreto de la cabecera X-Webhook-Token del callback del worker (obligatorio en prod, >= 32
# chars: openssl rand -hex 32). El worker lo recibe por su entorno, nunca dentro del job.
TRAINING_WEBHOOK_SECRET=
# URL base pública a la que el worker llama de vuelta (…/webhooks/training-update);
# desde otro contenedor no es localhost (p. ej. http://xeye-java-backend:8000).
BACKEND_URL=http://localhost:8000
# Modelos ofrecidos al lanzar (el primero = por defecto); worker y search-service deben poder cargarlos.
TRAINING_EMBEDDING_MODELS=paraphrase-multilingual-MiniLM-L12-v2,paraphrase-multilingual-mpnet-base-v2
# Retardo de la finalización simulada del provider mock (ms).
TRAINING_MOCK_DELAY_MS=500
# Minutos sin webhook tras los que un training lanzado se marca fallido; 0 desactiva el barrido.
TRAINING_STALLED_AFTER_MINUTES=30
# Máximo de trainings ejecutándose a la vez en todo el backend
# Cola: runs lanzados a la vez por usuario (equidad) y retención de runs terminados (días).
TRAINING_MAX_CONCURRENT_PER_USER=1
TRAINING_RETENTION_DAYS=90
TRAINING_MAX_CONCURRENT=1

# Precio preestablecido de un entrenamiento, en EUR: fijo + por descripción LLM a generar.
TRAINING_FIXED_PRICE=0.1
TRAINING_PRICE_PER_DESCRIPTION=0.0053

# --- Training: provider docker ---
TRAINING_DOCKER_IMAGE=xeye-training-service:latest
# Dónde escribe este proceso el JSON del job, y ese mismo directorio tal como lo ve el
# daemon de docker (difieren cuando el backend corre en contenedor).
TRAINING_INPUT_DIR=/tmp/xeye-training
TRAINING_HOST_INPUT_DIR=/tmp/xeye-training
TRAINING_DOCKER_NETWORK=xeye-network
# Variables KEY=VALUE extra para el worker, p. ej. ENRICHER=groq,GROQ_API_KEY=...
TRAINING_DOCKER_ENV=
# Valor de `docker run --gpus` ("all", "device=0", …); si no hay GPU se reintenta en CPU. Vacío fuerza CPU.
TRAINING_DOCKER_GPUS=all
TRAINING_DOCKER_BINARY=docker

# --- Training: provider runpod ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_TIMEOUT_SECONDS=30

# --- Search ---
# Providers: log (solo loguea, por defecto en dev) | http (POST al microservicio de búsqueda).
SEARCH_PROVIDER=log
SEARCH_SERVICE_URL=http://localhost:8002
# Secreto compartido backend<->search (pushes, notificaciones y /internal/search/*).
# Obligatorio en prod, >= 32 chars (openssl rand -hex 32); el mismo INTERNAL_TOKEN en search.
# Retención del historial de búsquedas (días; 0 = siempre).
SEARCH_LOG_RETENTION_DAYS=180
SEARCH_INTERNAL_TOKEN=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# --- Cuentas y autenticación ---
# URL pública de la consola: enlaces de los emails (verificar, recuperar) y retorno del SSO. Obligatorio en prod.
FRONTEND_URL=http://localhost:3000
# false = entrar sin verificar el email (solo dev/pruebas; en prod déjalo en true).
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Emails (separados por comas) que se convierten en admin al iniciar sesión: bootstrap del primer admin de prod.
ADMIN_EMAILS=
# Peticiones por minuto y por IP a los endpoints públicos de auth (<= 0 desactiva). El bloqueo
# progresivo por cuenta (5 fallos -> 1, 2, 4… minutos) no es configurable.
AUTH_RATE_LOGIN_PER_MINUTE=10
AUTH_RATE_REGISTER_PER_MINUTE=5
AUTH_RATE_PASSWORD_RESET_PER_MINUTE=5
# Contraseñas filtradas: hibp (Have I Been Pwned por k-anonimato, falla abierto) | none (dev por defecto).
PASSWORD_BREACH_CHECK=none
# CAPTCHA opcional en registro/login: none | turnstile (Cloudflare; la consola carga el widget sola).
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
# Nombre que muestran las apps de 2FA.
MFA_ISSUER=XEYE
# Días sin volver a pedir el código 2FA en un dispositivo recordado (0 = siempre).
MFA_TRUST_DAYS=30
# SSO (OIDC). Cada proveedor se activa al tener client id + secret. Redirect URI a registrar:
# {BACKEND_URL}/auth/sso/google/callback y {BACKEND_URL}/auth/sso/microsoft/callback
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=common

# --- Email transaccional ---
# log (dev: el email y sus enlaces salen en el log del backend) | smtp (buzón IONOS) | resend.
# En prod es obligatorio smtp o resend (con verificación de email activa).
EMAIL_PROVIDER=log
EMAIL_FROM=XEYE <noreply@xeye.es>
EMAIL_REPLY_TO=info@xeye.es
# Solo smtp. IONOS: smtp.ionos.es:587 (STARTTLS), usuario = buzón completo, contraseña del buzón.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Solo resend.
RESEND_API_KEY=

# --- Error tracking (Sentry) ---
# DSN del proyecto "xeye-backend"; vacío = desactivado.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
