# Imagen de desarrollo: ejecuta la app con Maven + Spring Boot DevTools, de modo que los
# cambios recompilados a target/classes provocan un reinicio automático dentro del contenedor.
# Para producción se construiría un fat jar sobre un JRE ligero.
FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# Solo la CLI de docker (sin daemon): el provider de training `docker` arranca un contenedor
# worker por training a través del socket que monta el compose. Inofensiva si no se usa.
ARG DOCKER_CLI_VERSION=27.3.1
RUN curl -fsSL "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_CLI_VERSION}.tgz" \
      | tar -xz -C /tmp docker/docker \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker

# Precalienta la caché de dependencias desde el POM (se reutiliza salvo que cambie pom.xml).
COPY pom.xml .
RUN mvn -B -q dependency:go-offline || true

# Las fuentes las monta docker-compose.dev.yml en runtime; este COPY solo se usa
# si se construye/ejecuta la imagen sin el mount.
COPY . .

EXPOSE 8000

CMD ["mvn", "spring-boot:run"]
